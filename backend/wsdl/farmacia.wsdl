      <xsd:element name="ListInventoryMovementsByBatch" type="tns:BatchMovementListRequestType"/>
      <xsd:element name="ListInventoryMovementsByBatchResponse" type="tns:MovementListResponseType"/>

      <xsd:element name="ListSales" type="tns:SaleListRequestType"/>
