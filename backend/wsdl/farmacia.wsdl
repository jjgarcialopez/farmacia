          <xsd:element name="item" type="tns:CreateSaleItemType" minOccurs="1" maxOccurs="100"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="CreateSaleRequestType">
        <xsd:sequence>
          <xsd:element name="items" type="tns:CreateSaleItemsType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="PreviewSaleRequestType">
        <xsd:sequence>
          <xsd:element name="items" type="tns:CreateSaleItemsType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="SalePreviewResponseType">
        <xsd:sequence>
          <xsd:element name="total" type="xsd:decimal"/>
          <xsd:element name="allocations" type="tns:SalePreviewAllocationArrayType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="CreateSaleResponseType">
        <xsd:sequence>
          <xsd:element name="sale" type="tns:SaleType"/>
          <xsd:element name="alerts" type="tns:SaleAlertArrayType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="SaleResponseType">
        <xsd:sequence><xsd:element name="sale" type="tns:SaleType"/></xsd:sequence>
      </xsd:complexType>

      <xsd:element name="Login" type="tns:LoginRequestType"/>
      <xsd:element name="LoginResponse" type="tns:LoginResponseType"/>
      <xsd:element name="ValidateSession" type="tns:EmptyRequestType"/>
      <xsd:element name="ValidateSessionResponse" type="tns:ValidateSessionResponseType"/>
      <xsd:element name="ListUsers" type="tns:UserListRequestType"/>
      <xsd:element name="ListUsersResponse" type="tns:UserListResponseType"/>
      <xsd:element name="GetUser" type="tns:IdRequestType"/>
      <xsd:element name="GetUserResponse" type="tns:UserResponseType"/>
      <xsd:element name="CreateUser" type="tns:CreateUserRequestType"/>
      <xsd:element name="CreateUserResponse" type="tns:UserResponseType"/>
      <xsd:element name="UpdateUser" type="tns:UpdateUserRequestType"/>
      <xsd:element name="UpdateUserResponse" type="tns:UserResponseType"/>
      <xsd:element name="DeactivateUser" type="tns:IdRequestType"/>
      <xsd:element name="DeactivateUserResponse" type="tns:DeactivateUserResponseType"/>
      <xsd:element name="ActivateUser" type="tns:IdRequestType"/>
      <xsd:element name="ActivateUserResponse" type="tns:ActivateUserResponseType"/>

      <xsd:element name="ListMedications" type="tns:MedicationListRequestType"/>
      <xsd:element name="ListMedicationsResponse" type="tns:MedicationListResponseType"/>
      <xsd:element name="GetMedication" type="tns:IdRequestType"/>
      <xsd:element name="GetMedicationResponse" type="tns:MedicationResponseType"/>
      <xsd:element name="CreateMedication" type="tns:CreateMedicationRequestType"/>
      <xsd:element name="CreateMedicationResponse" type="tns:MedicationResponseType"/>
      <xsd:element name="UpdateMedication" type="tns:UpdateMedicationRequestType"/>
      <xsd:element name="UpdateMedicationResponse" type="tns:MedicationResponseType"/>
      <xsd:element name="DeactivateMedication" type="tns:IdRequestType"/>
      <xsd:element name="DeactivateMedicationResponse" type="tns:DeactivateMedicationResponseType"/>

      <xsd:element name="ListBatches" type="tns:BatchListRequestType"/>
      <xsd:element name="ListBatchesResponse" type="tns:BatchListResponseType"/>
      <xsd:element name="GetBatch" type="tns:IdRequestType"/>
      <xsd:element name="GetBatchResponse" type="tns:BatchResponseType"/>
      <xsd:element name="CreateBatch" type="tns:CreateBatchRequestType"/>
      <xsd:element name="CreateBatchResponse" type="tns:BatchResponseType"/>
      <xsd:element name="UpdateBatch" type="tns:UpdateBatchRequestType"/>
      <xsd:element name="UpdateBatchResponse" type="tns:BatchResponseType"/>
      <xsd:element name="DeleteBatch" type="tns:IdRequestType"/>
      <xsd:element name="DeleteBatchResponse" type="tns:BooleanResponseType"/>
      <xsd:element name="ListExpirationAlerts" type="tns:PageRequestType"/>
      <xsd:element name="ListExpirationAlertsResponse" type="tns:ExpirationAlertListResponseType"/>

      <xsd:element name="ListInventoryMovements" type="tns:MovementListRequestType"/>
