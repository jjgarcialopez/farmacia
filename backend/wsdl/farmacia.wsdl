<?xml version="1.0" encoding="UTF-8"?>
<definitions
  name="FarmaciaService"
  targetNamespace="urn:farmacia:v1"
  xmlns="http://schemas.xmlsoap.org/wsdl/"
  xmlns:tns="urn:farmacia:v1"
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <types>
    <xsd:schema targetNamespace="urn:farmacia:v1" elementFormDefault="qualified">
      <xsd:simpleType name="RoleType">
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="administrador"/>
          <xsd:enumeration value="operador"/>
          <xsd:enumeration value="consulta"/>
          <xsd:enumeration value="auditor"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="SaleStateType">
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="confirmada"/>
          <xsd:enumeration value="revertida"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="MovementKindType">
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="entrada"/>
          <xsd:enumeration value="salida"/>
          <xsd:enumeration value="ajuste"/>
          <xsd:enumeration value="reversión"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:complexType name="AuthHeaderType">
        <xsd:sequence>
          <xsd:element name="token" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:element name="AuthHeader" type="tns:AuthHeaderType"/>

      <xsd:complexType name="UserType">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:long"/>
          <xsd:element name="nombre" type="xsd:string"/>
          <xsd:element name="correo" type="xsd:string"/>
          <xsd:element name="rol" type="tns:RoleType"/>
          <xsd:element name="activo" type="xsd:boolean"/>
          <xsd:element name="creadoEn" type="xsd:dateTime"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="MedicationType">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:long"/>
          <xsd:element name="codigo" type="xsd:string"/>
          <xsd:element name="nombre" type="xsd:string"/>
          <xsd:element name="principioActivo" type="xsd:string"/>
          <xsd:element name="presentacion" type="xsd:string"/>
          <xsd:element name="requiereFormula" type="xsd:boolean"/>
          <xsd:element name="precioReferencia" type="xsd:decimal"/>
          <xsd:element name="activo" type="xsd:boolean"/>
          <xsd:element name="creadoEn" type="xsd:dateTime"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="BatchType">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:long"/>
          <xsd:element name="medicamentoId" type="xsd:long"/>
          <xsd:element name="medicamentoNombre" type="xsd:string"/>
          <xsd:element name="codigoLote" type="xsd:string"/>
          <xsd:element name="fechaVencimiento" type="xsd:date"/>
          <xsd:element name="stock" type="xsd:int"/>
          <xsd:element name="costoUnitario" type="xsd:decimal"/>
          <xsd:element name="precioVenta" type="xsd:decimal"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="SaleItemType">
        <xsd:sequence>
          <xsd:element name="loteId" type="xsd:long"/>
          <xsd:element name="medicamentoId" type="xsd:long"/>
          <xsd:element name="medicamentoNombre" type="xsd:string"/>
          <xsd:element name="codigoLote" type="xsd:string"/>
          <xsd:element name="cantidad" type="xsd:int"/>
          <xsd:element name="precioUnitario" type="xsd:decimal"/>
          <xsd:element name="subtotal" type="xsd:decimal"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="SaleItemsType">
        <xsd:sequence>
          <xsd:element name="item" type="tns:SaleItemType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="SaleType">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:long"/>
          <xsd:element name="numero" type="xsd:string"/>
          <xsd:element name="usuarioId" type="xsd:long"/>
          <xsd:element name="usuarioNombre" type="xsd:string" minOccurs="0"/>
          <xsd:element name="cantidadProductos" type="xsd:int" minOccurs="0"/>
          <xsd:element name="fecha" type="xsd:dateTime"/>
          <xsd:element name="total" type="xsd:decimal"/>
          <xsd:element name="estado" type="tns:SaleStateType"/>
          <xsd:element name="items" type="tns:SaleItemsType" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="MovementType">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:long"/>
          <xsd:element name="loteId" type="xsd:long"/>
          <xsd:element name="ventaId" type="xsd:long" minOccurs="0"/>
          <xsd:element name="usuarioId" type="xsd:long"/>
          <xsd:element name="usuarioNombre" type="xsd:string"/>
          <xsd:element name="usuarioRol" type="tns:RoleType"/>
          <xsd:element name="tipo" type="tns:MovementKindType"/>
          <xsd:element name="cantidad" type="xsd:int"/>
          <xsd:element name="stockAntes" type="xsd:int"/>
          <xsd:element name="stockDespues" type="xsd:int"/>
