      </xsd:complexType>

      <xsd:complexType name="SaleListRequestType">
        <xsd:sequence>
          <xsd:element name="estado" type="tns:SaleStateType" minOccurs="0"/>
          <xsd:element name="fechaDesde" type="xsd:date" minOccurs="0"/>
          <xsd:element name="fechaHasta" type="xsd:date" minOccurs="0"/>
          <xsd:element name="busqueda" type="xsd:string" minOccurs="0"/>
          <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
          <xsd:element name="offset" type="xsd:int" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="SaleListResponseType">
