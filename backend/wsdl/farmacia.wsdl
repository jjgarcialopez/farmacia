          <xsd:element name="fecha" type="xsd:dateTime"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="UserArrayType">
        <xsd:sequence>
          <xsd:element name="user" type="tns:UserType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="MedicationArrayType">
        <xsd:sequence>
          <xsd:element name="medication" type="tns:MedicationType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="BatchArrayType">
        <xsd:sequence>
          <xsd:element name="batch" type="tns:BatchType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="MovementArrayType">
        <xsd:sequence>
          <xsd:element name="movement" type="tns:MovementType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="SaleArrayType">
        <xsd:sequence>
          <xsd:element name="sale" type="tns:SaleType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="SalePreviewAllocationType">
        <xsd:sequence>
          <xsd:element name="medicamentoId" type="xsd:long"/>
          <xsd:element name="medicamentoNombre" type="xsd:string"/>
          <xsd:element name="codigoLote" type="xsd:string"/>
          <xsd:element name="fechaVencimiento" type="xsd:date"/>
          <xsd:element name="cantidad" type="xsd:int"/>
          <xsd:element name="existenciasDisponibles" type="xsd:int"/>
          <xsd:element name="precioUnitario" type="xsd:decimal"/>
          <xsd:element name="subtotal" type="xsd:decimal"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="SalePreviewAllocationArrayType">
        <xsd:sequence>
          <xsd:element name="allocation" type="tns:SalePreviewAllocationType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="ExpirationAlertType">
        <xsd:sequence>
          <xsd:element name="batch" type="tns:BatchType"/>
          <xsd:element name="diasParaVencer" type="xsd:int"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="ExpirationAlertArrayType">
        <xsd:sequence>
          <xsd:element name="alert" type="tns:ExpirationAlertType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="SaleAlertType">
        <xsd:sequence>
          <xsd:element name="loteId" type="xsd:long"/>
          <xsd:element name="medicamentoNombre" type="xsd:string"/>
          <xsd:element name="codigoLote" type="xsd:string"/>
          <xsd:element name="fechaVencimiento" type="xsd:date"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="SaleAlertArrayType">
        <xsd:sequence>
          <xsd:element name="alert" type="tns:SaleAlertType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="LoginRequestType">
        <xsd:sequence>
          <xsd:element name="correo" type="xsd:string"/>
          <xsd:element name="password" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="LoginResponseType">
        <xsd:sequence>
          <xsd:element name="token" type="xsd:string"/>
          <xsd:element name="expiresInSeconds" type="xsd:int"/>
          <xsd:element name="user" type="tns:UserType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="EmptyRequestType">
        <xsd:sequence/>
      </xsd:complexType>
      <xsd:complexType name="ValidateSessionResponseType">
        <xsd:sequence>
          <xsd:element name="valid" type="xsd:boolean"/>
          <xsd:element name="user" type="tns:UserType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="PageRequestType">
        <xsd:sequence>
          <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
          <xsd:element name="offset" type="xsd:int" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="UserListRequestType">
        <xsd:sequence>
          <xsd:element name="rol" type="tns:RoleType" minOccurs="0"/>
          <xsd:element name="activo" type="xsd:boolean" minOccurs="0"/>
          <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
          <xsd:element name="offset" type="xsd:int" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="IdRequestType">
        <xsd:sequence><xsd:element name="id" type="xsd:long"/></xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="CreateUserRequestType">
        <xsd:sequence>
          <xsd:element name="nombre" type="xsd:string"/>
          <xsd:element name="correo" type="xsd:string"/>
          <xsd:element name="password" type="xsd:string"/>
          <xsd:element name="rol" type="tns:RoleType" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="UpdateUserRequestType">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:long"/>
          <xsd:element name="nombre" type="xsd:string" minOccurs="0"/>
          <xsd:element name="correo" type="xsd:string" minOccurs="0"/>
          <xsd:element name="password" type="xsd:string" minOccurs="0"/>
          <xsd:element name="rol" type="tns:RoleType" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="PageResponseType">
        <xsd:sequence>
          <xsd:element name="total" type="xsd:int"/>
          <xsd:element name="limit" type="xsd:int"/>
          <xsd:element name="offset" type="xsd:int"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="UserListResponseType">
        <xsd:sequence>
          <xsd:element name="total" type="xsd:int"/>
          <xsd:element name="limit" type="xsd:int"/>
          <xsd:element name="offset" type="xsd:int"/>
          <xsd:element name="users" type="tns:UserArrayType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="UserResponseType">
        <xsd:sequence><xsd:element name="user" type="tns:UserType"/></xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="DeactivateUserResponseType">
        <xsd:sequence>
          <xsd:element name="success" type="xsd:boolean"/>
          <xsd:element name="user" type="tns:UserType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="ActivateUserResponseType">
        <xsd:sequence>
          <xsd:element name="success" type="xsd:boolean"/>
          <xsd:element name="user" type="tns:UserType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="BooleanResponseType">
        <xsd:sequence><xsd:element name="success" type="xsd:boolean"/></xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="MedicationListRequestType">
        <xsd:sequence>
          <xsd:element name="nombreOCodigo" type="xsd:string" minOccurs="0"/>
          <xsd:element name="principioActivo" type="xsd:string" minOccurs="0"/>
          <xsd:element name="activo" type="xsd:boolean" minOccurs="0"/>
          <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
          <xsd:element name="offset" type="xsd:int" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="CreateMedicationRequestType">
        <xsd:sequence>
          <xsd:element name="codigo" type="xsd:string"/>
          <xsd:element name="nombre" type="xsd:string"/>
          <xsd:element name="principioActivo" type="xsd:string"/>
          <xsd:element name="presentacion" type="xsd:string"/>
          <xsd:element name="requiereFormula" type="xsd:boolean" minOccurs="0"/>
          <xsd:element name="precioReferencia" type="xsd:decimal" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="UpdateMedicationRequestType">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:long"/>
          <xsd:element name="codigo" type="xsd:string" minOccurs="0"/>
          <xsd:element name="nombre" type="xsd:string" minOccurs="0"/>
          <xsd:element name="principioActivo" type="xsd:string" minOccurs="0"/>
          <xsd:element name="presentacion" type="xsd:string" minOccurs="0"/>
          <xsd:element name="requiereFormula" type="xsd:boolean" minOccurs="0"/>
          <xsd:element name="precioReferencia" type="xsd:decimal" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="MedicationListResponseType">
        <xsd:sequence>
          <xsd:element name="total" type="xsd:int"/>
          <xsd:element name="limit" type="xsd:int"/>
          <xsd:element name="offset" type="xsd:int"/>
          <xsd:element name="medications" type="tns:MedicationArrayType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="MedicationResponseType">
        <xsd:sequence><xsd:element name="medication" type="tns:MedicationType"/></xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="DeactivateMedicationResponseType">
        <xsd:sequence>
          <xsd:element name="success" type="xsd:boolean"/>
          <xsd:element name="medication" type="tns:MedicationType"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="BatchListRequestType">
        <xsd:sequence>
          <xsd:element name="medicamentoId" type="xsd:long" minOccurs="0"/>
          <xsd:element name="codigoLote" type="xsd:string" minOccurs="0"/>
          <xsd:element name="fechaVencimientoDesde" type="xsd:date" minOccurs="0"/>
          <xsd:element name="fechaVencimientoHasta" type="xsd:date" minOccurs="0"/>
          <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
          <xsd:element name="offset" type="xsd:int" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="CreateBatchRequestType">
        <xsd:sequence>
          <xsd:element name="medicamentoId" type="xsd:long"/>
          <xsd:element name="codigoLote" type="xsd:string"/>
          <xsd:element name="fechaVencimiento" type="xsd:date"/>
          <xsd:element name="stock" type="xsd:int" minOccurs="0"/>
          <xsd:element name="costoUnitario" type="xsd:decimal"/>
          <xsd:element name="precioVenta" type="xsd:decimal"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="UpdateBatchRequestType">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:long"/>
          <xsd:element name="medicamentoId" type="xsd:long" minOccurs="0"/>
          <xsd:element name="codigoLote" type="xsd:string" minOccurs="0"/>
          <xsd:element name="fechaVencimiento" type="xsd:date" minOccurs="0"/>
          <xsd:element name="stock" type="xsd:int" minOccurs="0"/>
          <xsd:element name="costoUnitario" type="xsd:decimal" minOccurs="0"/>
          <xsd:element name="precioVenta" type="xsd:decimal" minOccurs="0"/>
          <xsd:element name="motivo" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="BatchListResponseType">
        <xsd:sequence>
          <xsd:element name="total" type="xsd:int"/>
          <xsd:element name="limit" type="xsd:int"/>
          <xsd:element name="offset" type="xsd:int"/>
          <xsd:element name="batches" type="tns:BatchArrayType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="BatchResponseType">
        <xsd:sequence><xsd:element name="batch" type="tns:BatchType"/></xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="ExpirationAlertListResponseType">
        <xsd:sequence>
          <xsd:element name="total" type="xsd:int"/>
          <xsd:element name="limit" type="xsd:int"/>
          <xsd:element name="offset" type="xsd:int"/>
          <xsd:element name="alerts" type="tns:ExpirationAlertArrayType"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="MovementListRequestType">
        <xsd:sequence>
          <xsd:element name="loteId" type="xsd:long" minOccurs="0"/>
          <xsd:element name="ventaId" type="xsd:long" minOccurs="0"/>
          <xsd:element name="tipo" type="tns:MovementKindType" minOccurs="0"/>
          <xsd:element name="fechaDesde" type="xsd:date" minOccurs="0"/>
          <xsd:element name="fechaHasta" type="xsd:date" minOccurs="0"/>
          <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
          <xsd:element name="offset" type="xsd:int" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="BatchMovementListRequestType">
        <xsd:sequence>
          <xsd:element name="loteId" type="xsd:long"/>
          <xsd:element name="ventaId" type="xsd:long" minOccurs="0"/>
          <xsd:element name="tipo" type="tns:MovementKindType" minOccurs="0"/>
          <xsd:element name="fechaDesde" type="xsd:date" minOccurs="0"/>
          <xsd:element name="fechaHasta" type="xsd:date" minOccurs="0"/>
          <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
          <xsd:element name="offset" type="xsd:int" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="MovementListResponseType">
        <xsd:sequence>
          <xsd:element name="total" type="xsd:int"/>
